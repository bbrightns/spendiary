# Cloudflare Worker URL (set after deploying the worker)
# During local dev: VITE_API_URL=http://localhost:8787
VITE_API_URL=https://spendiary-api.<your-subdomain>.workers.dev

# Must match the AUTH_TOKEN secret you set with:
#   cd worker && wrangler secret put AUTH_TOKEN
VITE_API_TOKEN=your-secret-token-here
